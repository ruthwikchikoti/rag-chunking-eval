# Copy to .env and adjust if needed. Defaults work for a standard local Ollama install.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# EMBED_BACKEND: "st" (sentence-transformers, default) or "ollama" (fallback, no torch)
EMBED_BACKEND=st
EMBED_MODEL_ST=sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_OLLAMA=nomic-embed-text
